// raven-prompt: small interactive prompts for the terminal.
//
//     from "github.com/martian56/raven-prompt" import ask, confirm, select
//
//     let name = ask("What's your name")
//     if confirm("Continue", true) {
//         let pick = select("Pick one", ["red", "green", "blue"])
//     }
//
// Each prompt reads a line from standard input. The question is styled with
// raven-color. On end of input the prompts return their default (an empty
// string, the given default, or -1 for a menu), so a piped or non-interactive
// run does not hang. The answer interpreters (`yes_no`, `parse_choice`) are
// plain functions you can call and test on their own.

import std.string
from std.io import input, println
from "github.com/martian56/raven-color" import Style

// Ask a free-text question and return the trimmed answer.
fun ask(question: str) -> str {
    return input(prompt(question)).trim()
}

// Ask, showing `default` in brackets; empty input returns the default.
fun ask_default(question: str, default: str) -> str {
    let answer = input(prompt("${question} [${default}]")).trim()
    if answer == "" {
        return default
    }
    return answer
}

// Ask a yes/no question. Empty input returns `default`.
fun confirm(question: str, default: bool) -> bool {
    var hint = "y/N"
    if default {
        hint = "Y/n"
    }
    return yes_no(input(prompt("${question} (${hint})")), default)
}

// Show a numbered menu and return the chosen 0-based index, or -1 for an
// invalid or empty answer.
fun select(question: str, options: list[str]) -> int {
    println(prompt(question))
    var i = 0
    while i < options.len() {
        println("  ${(i + 1).to_string()}) ${options[i]}")
        i += 1
    }
    return parse_choice(input(Style.new().cyan().apply("> ")), options.len())
}

// Interpret a yes/no answer: `y`/`yes` (any case) is true, empty is `default`,
// anything else is false.
fun yes_no(answer: str, default: bool) -> bool {
    let a = answer.trim().to_lower()
    if a == "" {
        return default
    }
    return a == "y" or a == "yes"
}

// Interpret a menu answer (a 1-based number) against `count` options, returning
// the 0-based index or -1 when it is not a valid choice.
fun parse_choice(answer: str, count: int) -> int {
    match answer.trim().parse_int() {
        case Some(n) {
            if n >= 1 and n <= count {
                return n - 1
            }
        }
        case None {}
    }
    return 0 - 1
}

// The styled prompt prefix: the question in cyan bold, then a space.
fun prompt(question: str) -> str {
    return "${Style.new().cyan().bold().apply(question)} "
}
